post_install() {
    post_upgrade "$@"
}

post_upgrade() {
    local kver="$1"
    cp -f "/usr/lib/modules/${kver}/vmlinuz" /boot/kernel8.img
    depmod -a "${kver}"
    echo "linux-uconsole-cm4: installed /boot/kernel8.img (${kver})"
    if command -v mkinitcpio >/dev/null 2>&1; then
        mkinitcpio -p linux-uconsole-cm4 || true
    fi
}

pre_remove() {
    :
}
